<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Barbarossa.Views"
       x:Class="Barbarossa.AppShell"
       Shell.TabBarBackgroundColor="#4A2E27"
       Shell.TabBarTitleColor="White"    
       Shell.TabBarUnselectedColor="#8A5E57"
       Shell.TabBarForegroundColor="White"    
       Shell.FlyoutBehavior="Disabled">

    <Shell.Resources>
        <ResourceDictionary>
            <!-- Стиль для скрытия заголовков -->
            <Style TargetType="Tab">
                <Setter Property="Shell.TabBarIsVisible" Value="True"/>
                <Setter Property="Shell.NavBarIsVisible" Value="False"/>
                <Setter Property="Title" Value="{x:Null}"/>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Нижнее меню -->
    <TabBar>
        <Tab Title="Услуги" Icon="services.png">
            <ShellContent ContentTemplate="{DataTemplate views:BookingPage}" />
        </Tab>

        <Tab Title="Товары" Icon="products.png">
            <ShellContent ContentTemplate="{DataTemplate views:ProductsPage}" />
        </Tab>

        <Tab Title="Профиль" Icon="profile.png">
            <ShellContent Route="ProfilePage"
                     ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>
    </TabBar>
</Shell>