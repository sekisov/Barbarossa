<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Barbarossa.Views"
       x:Class="Barbarossa.AppShell"
       Shell.FlyoutBehavior="Disabled">
    <!-- Отключаем Flyout, если не нужен -->

    <!-- Нижнее меню -->
    <TabBar>
        <Tab Title="Услуги" Icon="services.png">
            <ShellContent ContentTemplate="{DataTemplate views:BookingPage}" />
        </Tab>

        <Tab Title="Товары" Icon="products.png">
            <ShellContent ContentTemplate="{DataTemplate views:ProductsPage}" />
        </Tab>

        <Tab Title="Профиль" Icon="profile.png">
            <ShellContent Route="ProfilePage"
                     ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>
    </TabBar>
</Shell>