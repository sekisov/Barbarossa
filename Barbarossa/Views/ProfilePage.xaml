<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Barbarossa.ViewModels"
             xmlns:converters="clr-namespace:Barbarossa.Converters"
             x:Class="Barbarossa.Views.ProfilePage"
             NavigationPage.HasNavigationBar="False"
             x:DataType="viewmodels:UserViewModel">

    <ContentPage.Resources>
        <converters:BoolToTextConverter x:Key="AuthButtonTextConverter" 
                                      TrueText="Выйти" 
                                      FalseText="Войти"/>

        <converters:BoolToTextConverter x:Key="AuthStatusConverter" 
                                      TrueText="Вы авторизованы" 
                                      FalseText="Вы не авторизованы"/>

        <converters:BoolToColorConverter x:Key="BoolToColorConverter"
                                       TrueColor="Green"
                                       FalseColor="Red"/>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Статус авторизации --><!--
            <Label Text="{Binding IsAuthenticated, Converter={StaticResource AuthStatusConverter}}"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="{Binding IsAuthenticated, Converter={StaticResource BoolToColorConverter}}"/>-->

            <!-- Данные пользователя -->
            <Border IsVisible="{Binding IsAuthenticated}"
                   BackgroundColor="White"
                   Stroke="LightGray"
                   StrokeThickness="1"
                   StrokeShape="RoundRectangle 10"
                   Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="Личные данные"
                           FontSize="18"
                           FontAttributes="Bold"/>

                    <Entry Text="{Binding Name}"
                           Placeholder="Имя"/>

                    <Entry Text="{Binding Phone}"
                           Placeholder="Телефон"
                           Keyboard="Telephone"/>

                    <Entry Text="{Binding Email}"
                           Placeholder="Email"
                           Keyboard="Email"/>

                    <Button Text="Обновить профиль"
                            Command="{Binding UpdateProfileCommand}"
                            BackgroundColor="#4A2E27"
                            TextColor="White"/>
                </StackLayout>
            </Border>

            <!-- Форма входа --><!--
            <Border IsVisible="{Binding IsAuthenticated, Converter={StaticResource InverseBoolConverter}}"
                   BackgroundColor="White"
                   Stroke="LightGray"
                   StrokeThickness="1"
                   StrokeShape="RoundRectangle 10"
                   Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="Вход в систему"
                           FontSize="18"
                           FontAttributes="Bold"/>

                    <Entry Text="{Binding Email}"
                           Placeholder="Email"
                           Keyboard="Email"/>

                    <Entry Text="{Binding Password}"
                           Placeholder="Пароль"
                           IsPassword="True"/>

                    <Button Text="Войти"
                            Command="{Binding LoginCommand}"
                            BackgroundColor="#4A2E27"
                            TextColor="White"/>

                    <Button Text="Зарегистрироваться"
                            Command="{Binding RegisterCommand}"
                            BackgroundColor="LightGray"
                            TextColor="Black"/>
                </StackLayout>
            </Border>-->

            <!-- Кнопка выхода/входа -->
            <!--<Button Text="{Binding IsAuthenticated, Converter={StaticResource AuthButtonTextConverter}}"
                    Command="{Binding SwitchAuthCommand}"
                    BackgroundColor="{Binding IsAuthenticated, Converter={StaticResource BoolToColorConverter}}"
                    TextColor="White"/>-->

        </StackLayout>
    </ScrollView>
</ContentPage>