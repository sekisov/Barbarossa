<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Barbarossa.Views.ProductsPage"
             xmlns:viewmodel="clr-namespace:Barbarossa.ViewModels"
             x:DataType="viewmodel:ProductsViewModel"
             Title="Товары">

    <RefreshView Command="{Binding LoadProductsCommand}"
                 IsRefreshing="{Binding IsLoading}">
        <CollectionView ItemsSource="{Binding Products}"
                       SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#EEEEEE"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Margin="5"
                            HeightRequest="350">
                        <StackLayout Spacing="5" Padding="10">
                            <!-- Изображение товара -->
                            <Image Source="{Binding ImageUrl}"
                                   Aspect="AspectFill"
                                   HeightRequest="150"/>

                            <!-- Название товара -->
                            <Label Text="{Binding Name}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"/>

                            <!-- Описание товара -->
                            <Label Text="{Binding Description}"
                                   FontSize="12"
                                   TextColor="#666666"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap"/>

                            <!-- Цена -->
                            <Label Text="{Binding Price, StringFormat='{0:C}'}"
                                   FontSize="16"
                                   TextColor="#4A2E27"
                                   FontAttributes="Bold"/>

                            <!-- Кнопка покупки -->
                            <Button Text="Купить"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ProductsViewModel}}, Path=BuyCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#4A2E27"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="40"/>
                        </StackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>